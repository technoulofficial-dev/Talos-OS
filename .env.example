# === Talos OS v8.0 Environment Variables ===
# Copy to .env and fill in your values.
# NEVER commit .env to version control.

# --- Supabase (database + auth + realtime) ---
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- NVIDIA NIM (cloud fallback) ---
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Ollama (local engine) ---
OLLAMA_HOST=http://127.0.0.1:11434

# --- Redis (Loom pub/sub + caching) ---
REDIS_URL=redis://127.0.0.1:6379

# --- G0DM0D3 (local network scanning) ---
G0DM0D3_ENABLED=true
G0DM0D3_SCAN_SUBNETS=192.168.0.0/24,10.0.0.0/24
G0DM0D3_OLLAMA_PORT=11434

# --- Budget Gate (cloud API cost control) ---
BUDGET_MONTHLY_USD=50
BUDGET_HOURLY_USD=5
BUDGET_PER_TASK_TOKENS=100000
BUDGET_PER_MINUTE_REQUESTS=30
BUDGET_HARD_KILL_AT=0.95

# --- Security ---
PIN_GATE_HASH=
JWT_SECRET=

# --- Application ---
NODE_ENV=development
TALOS_PORT=8642
MISSION_CONTROL_PORT=3000
LOG_LEVEL=info