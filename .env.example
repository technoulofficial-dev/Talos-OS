# ============================================================
# Talos OS v8.0 — Environment Variables
# Copy this to .env and fill in your values.
# ============================================================

# ── AI Engine — G0DM0D3 Stack ──────────────────────────────

# OpenRouter free models (Tier 1 — free, unlimited)
# Get API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama local (Tier 2 — free, runs locally)
# Runs on localhost by default, no key needed
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_LOCAL_MODEL=llama3.2

# NVIDIA NIM cloud (Tier 3 — paid, last resort fallback)
# Get API key at https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_NIM_API_KEY=nvapi-your-key-here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Opt-in Providers (unreliable, enable at your own risk) ──
# Set any of these to "true" to enable experimental providers
# FEAT_KEYLESSAI=false
# FEAT_FREETHEAI=false
# FEAT_FREE_AI_ROUTER=false
# FEAT_PUTER=false

# ── Owl Alpha (free, agentic, 1M context, top-priority) ──
# Opt-OUT (default ON). Free on OpenRouter but logs prompts/completions.
# Set to "false" if you handle sensitive data and want to skip Owl Alpha.
# TALOS_OWL_ALPHA_ENABLED=true

# ── Budget Gate ─────────────────────────────────────────────
# Defaults shown below. Uncomment to override.
# BUDGET_MONTHLY_USD=50
# BUDGET_HOURLY_USD=5
# BUDGET_PER_TASK_TOKENS=100000
# BUDGET_PER_MINUTE_REQUESTS=30
# BUDGET_HARD_KILL_AT=0.95

# ── Database ────────────────────────────────────────────────
# Local Supabase runs in Docker (ports 54321 Studio / 54322 direct Postgres)
# Start with: docker compose up -d
# Studio available at http://localhost:54321 when running
#
# For hosted Supabase MCP (optional):
# Get PAT at https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=your-personal-access-token

# ── Database Dual-Mode (opt-in per module) ─────────────────
# When "true", these modules write to Supabase in addition to in-memory.
# Default: "false" (in-memory only, existing tests pass unchanged).
# TALOS_WORKFLOW_DB_ENABLED=false
# TALOS_DEVICE_DB_ENABLED=false
# TALOS_SPEND_DB_ENABLED=false
# TALOS_AUDIT_DB_ENABLED=false

# ── External MCP / GitHub ───────────────────────────────────
# GITHUB_TOKEN=ghp_your-token-here

# ── Design Tools (Optional — for Magic /ui + open-design) ──
# 21st.dev Magic MCP — generates React component variants.
# Sign up free at https://21st.dev/magic, then copy the API key.
# The MCP server reads TWENTY_FIRST_API_KEY first, then API_KEY as fallback.
# The shell var name (TWENTYFIRST_API_KEY) is mapped to both in opencode.json.
# Required for the `magic` MCP tool calls to succeed.
# TWENTYFIRST_API_KEY=your-21st-dev-api-key

# open-design MCP — bridges to the open-design daemon (port 7456).
# Install the open-design desktop app from https://github.com/nexu-io/open-design
# The daemon starts automatically when the app launches.
# Required for the `open-design` MCP tool calls to succeed.
# OD_DAEMON_URL=http://localhost:7456
